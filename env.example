# ── Banco de dados ─────────────────────────────────────────────
# String de conexão Neon (ou qualquer PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Sessão ─────────────────────────────────────────────────────
# Obrigatório — gere um valor forte: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=

# ── CORS ───────────────────────────────────────────────────────
# URL do frontend em produção (sem barra no final)
# Em desenvolvimento o padrão é http://localhost:3000
FRONTEND_URL=https://seu-dominio.com

# ── Ambiente ───────────────────────────────────────────────────
# Use 'production' em deploy — ativa secure cookies e bloqueia rotas de teste
NODE_ENV=development

# ── Chatbot ────────────────────────────────────────────────────
# Chave da API Groq (https://console.groq.com)
GROQ_API_KEY=

# ── Servidor ───────────────────────────────────────────────────
PORT=3000
